<view class="page"><view class="hero center"><view class="big">{{group.avatar}}</view><view class="title">{{group.name}}</view><view class="subtitle">{{group.members}} HKU members</view></view><view class="card"><view class="section-title first">About this group</view><view class="subtitle">{{group.description}}</view></view><button class="button" bindtap="chat" wx:if="{{group.joined}}">Open group chat</button><button class="secondary" bindtap="join">{{group.joined ? 'Leave group' : 'Join group'}}</button></view>
