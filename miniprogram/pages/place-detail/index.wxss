.detail-page{min-height:100vh;background:#fff;position:relative}.mini-map{width:100%;height:420rpx}.back-button{position:absolute;left:24rpx;top:72rpx;z-index:8;width:74rpx;height:74rpx;border-radius:50%;background:#fff;color:#347fc9;display:flex;align-items:center;justify-content:center;font-size:56rpx;box-shadow:0 4rpx 16rpx rgba(0,0,0,.25)}.content-sheet{position:relative;margin-top:-26rpx;background:#fff;border-radius:18rpx 18rpx 0 0;padding:10rpx 20rpx 40rpx}.grab{width:88rpx;height:7rpx;border-radius:6rpx;background:#c9c9c9;margin:0 auto 14rpx}.search-strip{height:58rpx;padding:0 14rpx;background:#ededed;border-radius:8rpx;color:#777;display:flex;align-items:center;font-size:22rpx}.search-strip text{margin-left:auto;font-size:38rpx}.place-head{display:flex;align-items:center;padding:20rpx 30rpx 18rpx;border-bottom:2rpx solid #ddd;box-shadow:0 6rpx 10rpx rgba(0,0,0,.08)}.center{text-align:center}.place-title{font-size:38rpx;font-weight:800}.place-sub{font-size:14rpx;margin:3rpx 0 5rpx}.distance{font-size:20rpx;color:#1f7de7;font-weight:600}.thumb{width:100rpx;height:100rpx;border-radius:10rpx;background:#dfe9ef;display:flex;align-items:center;justify-content:center;font-size:48rpx}.people-section{padding:22rpx 8rpx 6rpx}.section-heading{display:flex;align-items:center;justify-content:space-between;font-size:24rpx;font-weight:700;margin-bottom:14rpx}.demo-label{font-size:16rpx;color:#97a1ad;font-weight:400}.people-scroll{width:100%;white-space:nowrap}.person-card{display:inline-flex;width:148rpx;margin-right:12rpx;padding:14rpx 10rpx;border-radius:16rpx;background:#f5f8fc;box-sizing:border-box;flex-direction:column;align-items:center;vertical-align:top}.person-avatar{width:76rpx;height:76rpx;border-radius:50%;background:#e4ebf4}.person-name{font-size:20rpx;font-weight:700;margin-top:8rpx}.person-status{width:100%;font-size:16rpx;color:#8993a0;margin-top:4rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;text-align:center}.empty-people{padding:25rpx;color:#8993a0;font-size:20rpx}.photos{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin-top:22rpx}.photo{height:280rpx;border-radius:10rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#fff;text-shadow:0 2rpx 5rpx rgba(0,0,0,.35);font-size:30rpx}.photo .small{font-size:17rpx;margin-top:8rpx}.p1{background:linear-gradient(150deg,#92bb91,#365f54)}.p2{background:linear-gradient(150deg,#d0bc96,#6a7b85)}.information{margin-top:28rpx;padding:20rpx 10rpx}.info-title{font-size:28rpx;font-weight:500}.info-copy{font-size:21rpx;line-height:1.55;color:#676767;margin-top:8rpx}.tags text{display:inline-block;margin:12rpx 8rpx 0 0;font-size:18rpx;color:#458ce6}.actions{display:flex;gap:10rpx}.actions button{flex:1;background:#5598ef;color:#fff;border:0;border-radius:8rpx;font-size:20rpx;line-height:66rpx;padding:0}.actions .navigate{background:#1677ff}
