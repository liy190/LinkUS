.screen{min-height:100vh;background:#fff}.search{height:48rpx;margin:10rpx 18rpx;border-radius:8rpx;background:#f1f1f1;color:#999;font-size:21rpx;display:flex;align-items:center;justify-content:center}.notice-row{display:flex;align-items:center;padding:15rpx 28rpx}.notice-icon{width:70rpx;height:70rpx;display:flex;align-items:center;justify-content:center;font-size:38rpx;margin-right:18rpx}.preview{max-width:430rpx;color:#929292;font-size:20rpx;margin-top:5rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.meta{align-self:stretch;display:flex;flex-direction:column;align-items:flex-end;justify-content:space-around}.time{color:#666;font-size:18rpx}
