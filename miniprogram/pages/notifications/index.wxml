<view class="screen"><linkus-header bind:add="add"/><view class="search">⌕ search</view><view wx:for="{{list}}" wx:key="id" class="notice-row" data-id="{{item.id}}" bindtap="open"><view class="notice-icon">{{item.icon}}</view><view class="grow"><view class="name">{{item.title}}</view><view class="preview">{{item.body}}</view></view><view class="meta"><view class="time">{{index ? '9:45 07/13' : '12:20 07/13'}}</view><view class="badge" wx:if="{{item.unread}}">{{index + 1}}</view></view></view></view>
