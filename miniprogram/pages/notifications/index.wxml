<view class="page no-pad"><view class="head row between"><view><view class="title">Updates</view><view class="muted">Campus and social alerts</view></view><view class="pill" bindtap="readAll">Mark all read</view></view><view class="list"><view wx:for="{{list}}" wx:key="id" class="list-card row {{item.unread ? 'unread' : ''}}" data-id="{{item.id}}" bindtap="open"><view class="notice-icon">{{item.icon}}</view><view class="grow"><view class="row"><view class="name">{{item.title}}</view><view class="dot" wx:if="{{item.unread}}"></view></view><view class="subtitle body">{{item.body}}</view></view><view class="chevron">›</view></view></view></view>
