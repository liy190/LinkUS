.chat-page{height:100vh;display:flex;flex-direction:column;background:#fff}.chat-nav{padding-right:24rpx;padding-bottom:10rpx;padding-left:24rpx;box-sizing:border-box;display:flex;align-items:center;justify-content:space-between;border-bottom:2rpx solid #eee;background:#fff;flex-shrink:0}.chat-nav>text{width:60rpx;text-align:center;color:#529ce8;font-size:42rpx}.chat-nav>text:last-child{color:#777;font-size:20rpx}.nav-person{display:flex;align-items:center;gap:12rpx}.nav-person image{width:54rpx;height:54rpx;border-radius:50%;background:#e7eef8}.nav-title{text-align:left;font-weight:700}.person{color:#777;font-size:18rpx;margin-top:2rpx}.messages{flex:1;padding:22rpx 30rpx;box-sizing:border-box;background:#fafafa}.date{text-align:center;color:#888;font-size:18rpx;margin-bottom:18rpx}.message-row{display:flex;align-items:flex-end;max-width:88%;margin:18rpx 0;gap:10rpx}.mine{margin-left:auto;text-align:right;justify-content:flex-end}.message-avatar{width:58rpx;height:58rpx;border-radius:50%;background:#e7eef8;flex-shrink:0;border:3rpx solid #fff;box-shadow:0 2rpx 8rpx rgba(21,52,89,.12)}.mine-avatar{margin-left:2rpx}.bubble-stack{max-width:calc(100% - 68rpx)}.mine .bubble-stack{max-width:calc(100% - 68rpx)}.bubble{display:inline-block;padding:18rpx 22rpx;background:#eee;border-radius:8rpx 22rpx 22rpx 22rpx;text-align:left;font-size:23rpx;word-break:break-word}.mine .bubble{background:#247cef;color:#fff;border-radius:22rpx 8rpx 22rpx 22rpx}.time,.author{font-size:17rpx;color:#999;margin:4rpx}.composer{background:#fff;border-top:2rpx solid #eee;padding:12rpx 20rpx calc(12rpx + env(safe-area-inset-bottom))}.input-row{height:66rpx;border-radius:8rpx;background:#eee;display:flex;align-items:center;padding:0 14rpx}.input-row input{flex:1}.input-row text{color:#14c561;font-size:43rpx;font-weight:800}.quick{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx;margin-top:16rpx}.quick view{display:flex;align-items:center;font-size:18rpx;color:#555}.quick b{width:44rpx;height:44rpx;border-radius:50%;color:#fff;display:flex;align-items:center;justify-content:center;margin-right:8rpx}.coral{background:#ef725e}.blue{background:#50aee8}.navy{background:#4d78b8}.yellow{background:#efc331}.cyan{background:#20bdd0}.green{background:#36c86c}
