.chat-page{height:100vh;display:flex;flex-direction:column;background:#fff}.chat-nav{padding-right:48rpx;padding-bottom:12rpx;padding-left:48rpx;box-sizing:border-box;display:flex;align-items:center;justify-content:space-between;background:#fff;flex-shrink:0}.nav-circle{width:72rpx;height:72rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#2c2d3a;font-size:36rpx;box-shadow:0 8rpx 24rpx rgba(13,10,44,.08)}.nav-title{font-size:34rpx;font-weight:700;color:#0d1217}.nav-circle.more{font-size:26rpx;letter-spacing:2rpx}.contact-bar{height:110rpx;padding:10rpx 48rpx;box-sizing:border-box;display:flex;align-items:center;justify-content:space-between;background:#fff;flex-shrink:0}.contact-person{display:flex;align-items:center}.contact-avatar{width:76rpx;height:76rpx;border-radius:50%;background:#e7eef8;margin-right:20rpx}.person-name{font-size:27rpx;font-weight:700;color:#0d1217}.person-status{margin-top:7rpx;color:#686a8a;font-size:19rpx}.contact-actions{display:flex;gap:16rpx}.contact-actions view{width:64rpx;height:64rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:29rpx;color:#2c2d3a;background:#fff}.messages{flex:1;padding:22rpx 46rpx;box-sizing:border-box;background:#f0f0f3;border-top:2rpx solid #e9eaeb;border-bottom:2rpx solid #e9eaeb}.date{text-align:center;color:#9a9bb1;font-size:18rpx;margin-bottom:20rpx}.message-row{display:flex;align-items:flex-end;max-width:94%;margin:20rpx 0;gap:12rpx}.mine{margin-left:auto;text-align:right;justify-content:flex-end}.message-avatar{width:58rpx;height:58rpx;border-radius:50%;background:#e7eef8;flex-shrink:0;border:3rpx solid #fff;box-shadow:0 2rpx 8rpx rgba(21,52,89,.12)}.bubble-stack{max-width:calc(100% - 70rpx)}.bubble{display:inline-block;padding:20rpx 24rpx;background:#fff;border-radius:28rpx 28rpx 28rpx 6rpx;text-align:left;font-size:26rpx;line-height:1.35;word-break:break-word;color:#2c2d3a}.mine .bubble{background:#1565c0;color:#fff;border-radius:28rpx 28rpx 6rpx 28rpx}.time,.author{font-size:18rpx;color:#9a9bb1;margin:6rpx 5rpx}.mine .time{color:#6d7f9d}.author{font-weight:600;color:#686a8a}.last-anchor{height:24rpx}.composer{background:#fff;padding:18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));flex-shrink:0}.input-row{height:70rpx;display:flex;align-items:center;gap:18rpx}.add-button{width:44rpx;color:#29b6f6;font-size:52rpx;font-weight:300;text-align:center}.input-row input{flex:1;height:62rpx;padding:0 24rpx;border-radius:20rpx;background:#e9e9e9;color:#0d1217}.send-button{width:50rpx;color:#09c53b;font-size:54rpx;font-weight:800;text-align:center}.quick{display:grid;grid-template-columns:repeat(3,1fr);gap:20rpx;margin-top:22rpx;padding:6rpx 8rpx}.quick view{display:flex;align-items:center;font-size:18rpx;color:#555}.quick b{width:46rpx;height:46rpx;border-radius:50%;color:#fff;display:flex;align-items:center;justify-content:center;margin-right:10rpx}.coral{background:#ef725e}.blue{background:#50aee8}.navy{background:#4d78b8}.yellow{background:#efc331}.cyan{background:#20bdd0}.green{background:#36c86c}
.quick-icon{width:46rpx;height:46rpx;border-radius:50%;color:#fff;display:flex;align-items:center;justify-content:center;margin-right:10rpx}
