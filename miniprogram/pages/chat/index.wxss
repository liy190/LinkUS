.chat-page{height:100vh;display:flex;flex-direction:column}.messages{flex:1;padding:28rpx;box-sizing:border-box}.message-row{max-width:72%;margin:24rpx 0}.mine{margin-left:auto;text-align:right}.bubble{display:inline-block;background:#fff;border-radius:8rpx 28rpx 28rpx 28rpx;padding:20rpx 24rpx;text-align:left;box-shadow:0 5rpx 20rpx rgba(30,50,80,.06)}.mine .bubble{background:#1677ff;color:#fff;border-radius:28rpx 8rpx 28rpx 28rpx}.time,.author{font-size:20rpx;color:#9099a8;margin:6rpx 10rpx}.composer{padding:18rpx 22rpx calc(18rpx + env(safe-area-inset-bottom));background:#fff}.input{background:#f1f4f8;border-radius:40rpx;padding:20rpx 28rpx}.send{margin-left:12rpx;background:#1677ff;color:#fff;border-radius:40rpx;font-size:24rpx;line-height:72rpx}
