.login-page{min-height:100vh;position:relative;overflow:hidden;background:#fff}.red-corner{position:absolute;left:-120rpx;top:-170rpx;width:500rpx;height:360rpx;border-radius:50%;background:#f20b1d;transform:rotate(-20deg)}.blue-corner{position:absolute;right:-160rpx;bottom:-170rpx;width:500rpx;height:380rpx;border-radius:50%;background:#1029e9;transform:rotate(-25deg)}.login-content{position:relative;z-index:2;padding:210rpx 80rpx 80rpx}.brand{color:#083fd2;font-size:86rpx;font-weight:900;font-style:italic;letter-spacing:-5rpx}.journey{margin-top:34rpx;color:#1684e9;font-size:44rpx;line-height:1.15}.journey b{color:#0763e3}.intro{margin:54rpx 0 26rpx;color:#4a7bb8;font-size:21rpx;line-height:1.55}.login-card{padding:28rpx;border-radius:20rpx;background:#fff;box-shadow:0 12rpx 42rpx rgba(32,73,144,.13)}.login-title{font-size:28rpx;font-weight:700;color:#183b70}.login-note{font-size:20rpx;line-height:1.5;color:#73839a;margin-top:10rpx}.continue{margin-top:24rpx;background:#0873ed;color:#fff;border:0;border-radius:10rpx;line-height:78rpx;font-weight:700}.continue[disabled]{opacity:.65}.privacy-note{text-align:center;color:#8a96a8;font-size:18rpx;margin-top:18rpx}.error{text-align:center;color:#d93025;font-size:19rpx;margin-top:12rpx}
