.login-page{min-height:100vh;position:relative;overflow:hidden;background:#fff}.red-corner{position:absolute;left:-160rpx;top:-190rpx;width:650rpx;height:420rpx;border-radius:50%;background:#ff191f;transform:rotate(-20deg)}.blue-corner{position:absolute;right:-190rpx;bottom:-210rpx;width:560rpx;height:430rpx;border-radius:50%;background:#1029e9;transform:rotate(-25deg)}.login-content{position:relative;z-index:2;padding:230rpx 80rpx 80rpx}.brand{width:560rpx;height:190rpx;margin-left:-28rpx}.journey{margin-top:-22rpx;color:#2176ed;font-size:58rpx;line-height:1.15}.journey-strong{color:#1267e8;font-weight:700}.intro{margin:120rpx 0 32rpx;color:#2176ed;font-size:27rpx;line-height:1.55}.login-card{padding:30rpx;border-radius:24rpx;background:#fff;box-shadow:0 12rpx 42rpx rgba(32,73,144,.12)}.login-title{font-size:30rpx;font-weight:700;color:#183b70}.login-note{font-size:21rpx;line-height:1.5;color:#73839a;margin-top:12rpx}.continue{margin-top:28rpx;background:#2176ed;color:#fff;border:0;border-radius:18rpx;line-height:96rpx;font-size:30rpx;font-weight:700}.continue[disabled]{opacity:.65}.privacy-note{text-align:center;color:#8a96a8;font-size:18rpx;margin-top:18rpx}.error{text-align:center;color:#d93025;font-size:19rpx;margin-top:12rpx}
