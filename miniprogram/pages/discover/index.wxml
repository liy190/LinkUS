<view class="screen">
  <linkus-header bind:add="add"/>
  <view class="discover-list">
    <view class="discover-row" data-url="/pages/moments/index" bindtap="open"><view class="ico coral">◉</view><text>Moments</text><text class="arrow">›</text></view>
    <view class="discover-row" data-url="/pages/activities/index" bindtap="open"><view class="ico green">♫</view><text>Activities</text><text class="arrow">›</text></view>
    <view class="discover-row" data-url="/pages/nearby/index" bindtap="open"><view class="ico blue">♧</view><text>Nearby people</text><text class="arrow">›</text></view>
    <view class="discover-row" data-url="/pages/search/index" bindtap="open"><view class="ico black">⌕</view><text>Search</text><text class="arrow">›</text></view>
    <view class="discover-row" data-url="/pages/favorites/index" bindtap="open"><view class="ico gold">★</view><text>Saved places</text><text class="arrow">›</text></view>
    <view class="discover-row" data-url="/pages/feedback/index" bindtap="open"><view class="ico blue">◎</view><text>Feedback</text><text class="arrow">›</text></view>
  </view>
  <view class="tab-safe"></view>
</view>
