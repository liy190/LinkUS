.grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx;margin-top:28rpx}.tile{min-height:230rpx;background:#fff;border-radius:28rpx;padding:28rpx;box-sizing:border-box;border-top:10rpx solid #1677ff;box-shadow:0 8rpx 26rpx rgba(40,55,90,.06)}.purple{border-color:#8f65e8}.green{border-color:#39b68b}.orange{border-color:#ff9b45}.icon{font-size:58rpx;margin-bottom:20rpx}.tile .muted{margin-top:10rpx;line-height:1.4}
