.edit-page{min-height:100vh;padding:18rpx 32rpx 40rpx;background:#fff}.sheet-handle{width:86rpx;height:7rpx;background:#ccc;border-radius:6rpx;margin:0 auto 12rpx}.sheet-title{text-align:center;font-size:32rpx;font-weight:700;margin-bottom:20rpx}.avatar-button{position:relative;width:156rpx;height:156rpx;padding:0;margin:0 auto;border-radius:50%;background:transparent;overflow:visible}.avatar-button::after{border:0}.avatar-edit{width:150rpx;height:150rpx;border-radius:50%;background:#dff4ff;border:3rpx solid #d8e4f2}.camera{position:absolute;right:0;top:4rpx;width:38rpx;height:38rpx;border-radius:50%;background:#43c6ef;color:#fff;font-size:22rpx;display:flex;align-items:center;justify-content:center}.avatar-help{text-align:center;color:#8a96a8;font-size:18rpx;margin:14rpx 0 24rpx}.form-row{display:flex;align-items:center;padding:20rpx 0;border-bottom:2rpx solid #eee}.form-row text{width:190rpx;color:#666}.form-row input{flex:1;text-align:right}.private-note{margin:28rpx 0;color:#888;font-size:22rpx;line-height:1.5}.save{background:#43c4ef;color:#fff;border:0;border-radius:8rpx;line-height:76rpx}.save[disabled]{opacity:.65}
