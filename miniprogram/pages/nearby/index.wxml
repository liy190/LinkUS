<view class="page"><view class="card notice">Only students who explicitly share a place for a limited time appear here. Exact coordinates are never shown.</view><view class="cards"><view wx:for="{{people}}" wx:key="id" class="person-card"><view class="person-avatar">{{item.avatar}}</view><view class="name">{{item.name}}</view><view class="muted status">{{item.status}}</view><view class="pill">{{places[index] ? places[index].short : 'HKU'}}</view><button class="secondary small" data-id="{{item.id}}" bindtap="message">Message</button></view></view></view>
