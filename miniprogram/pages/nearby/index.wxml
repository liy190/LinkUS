<view class="page"><view class="card notice">Only students who explicitly share a place for a limited time appear here. Exact distance is calculated in the cloud only when both users opt in.</view><view class="cards"><view wx:for="{{people}}" wx:key="userId" class="person-card"><image class="person-avatar" src="{{item.avatar}}" mode="aspectFill"/><view class="name">{{item.name}}</view><view class="muted status">{{item.status}}</view><view class="distance-pill {{item.distanceMode === 'exact' ? 'exact' : 'fuzzy'}}" wx:if="{{item.distanceLabel}}">{{item.distanceLabel}}</view><view class="pill" wx:else>{{places[index] ? places[index].short : 'HKU'}}</view><button class="secondary small" data-id="{{item.userId || item.id}}" bindtap="message">Message</button></view></view><view class="empty card" wx:if="{{live && !people.length}}">No nearby users are sharing a campus place right now.</view></view>
