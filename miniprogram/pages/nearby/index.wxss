.notice{color:#526079;line-height:1.55}.cards{display:grid;grid-template-columns:1fr 1fr;gap:20rpx}.person-card{background:#fff;border-radius:28rpx;padding:28rpx;text-align:center;box-shadow:0 8rpx 24rpx rgba(40,55,90,.07)}.person-avatar{width:110rpx;height:110rpx;border-radius:55rpx;background:#edf5ff;margin:0 auto 18rpx;display:flex;align-items:center;justify-content:center;font-size:54rpx}.status{min-height:70rpx;margin-top:8rpx}.small{font-size:24rpx;line-height:66rpx;margin-top:18rpx}
