<view class="page">
  <view class="hero"><view class="title">You control your location</view><view class="subtitle">Location sharing is off by default, expires automatically and can be revoked at any time.</view></view>
  <view class="switch-row row between"><view><view class="name">Share my campus location</view><view class="muted">Published only while you opt in</view></view><switch color="#1677ff" checked="{{privacy.enabled}}" bindchange="toggle"/></view>
  <view class="card">
    <view class="label">Who can see it</view>
    <radio-group bindchange="scope"><label class="option"><radio value="sameActivity" checked="{{privacy.scope === 'sameActivity'}}" color="#1677ff"/> People in the same activity or group</label><label class="option"><radio value="campus" checked="{{privacy.scope === 'campus'}}" color="#1677ff"/> HKU users nearby</label></radio-group>
    <view class="label">Automatic stop</view><picker range="{{durations}}" value="{{durationIndex}}" bindchange="duration"><view class="picker">After {{privacy.duration}} minutes ›</view></picker>
    <view class="label">Precision</view>
    <radio-group bindchange="precision"><label class="option"><radio value="place" checked="{{privacy.precision === 'place'}}" color="#1677ff"/> Place level (recommended)</label><label class="option"><radio value="exact" checked="{{privacy.precision === 'exact'}}" color="#1677ff"/> Precise position for my activity/group</label></radio-group>
    <view class="warning" wx:if="{{privacy.precision === 'exact'}}">Precise position is shared only with your selected activity/group. Campus-wide sharing automatically falls back to place level.</view>
    <view class="distance-consent">
      <view class="row between"><view><view class="name">Mutual precise distance</view><view class="muted">Show an exact distance only when both users enable this</view></view><switch color="#1677ff" checked="{{privacy.mutualDistance}}" bindchange="mutualDistance"/></view>
      <view class="distance-note">Your precise coordinates stay inside the cloud function and are never sent to the other phone. Without mutual consent, LinkUS shows only a fuzzy range.</view>
    </view>
  </view>
  <button class="secondary danger" bindtap="revoke" wx:if="{{privacy.enabled}}">Stop sharing now</button>
  <view class="card legal"><view class="name">Privacy promise</view><view class="subtitle">No movement history is kept. Expired records are hidden and removed by the backend. You can revoke access at any time.</view></view>
</view>
