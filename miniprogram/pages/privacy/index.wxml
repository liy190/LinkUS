<view class="page"><view class="hero"><view class="title">You control your location</view><view class="subtitle">LinkUS shares only the HKU place you choose, never a continuous route or exact coordinates.</view></view><view class="switch-row row between"><view><view class="name">Share my campus place</view><view class="muted">Off by default and time limited</view></view><switch color="#1677ff" checked="{{privacy.enabled}}" bindchange="toggle"/></view><view class="card"><view class="label">Who can see it</view><radio-group bindchange="scope"><label class="option"><radio value="sameActivity" checked="{{privacy.scope === 'sameActivity'}}" color="#1677ff"/> People in the same activity or group</label><label class="option"><radio value="campus" checked="{{privacy.scope === 'campus'}}" color="#1677ff"/> HKU users nearby</label></radio-group><view class="label">Automatic stop</view><picker range="{{durations}}" value="{{durationIndex}}" bindchange="duration"><view class="picker">After {{privacy.duration}} minutes ›</view></picker><view class="label">Precision</view><view class="picker">Place level only (recommended)</view></view><button class="secondary danger" bindtap="revoke" wx:if="{{privacy.enabled}}">Stop sharing now</button><view class="card legal"><view class="name">Privacy promise</view><view class="subtitle">No background tracking, no movement history and no precise location for strangers. You can revoke access at any time.</view></view></view>
