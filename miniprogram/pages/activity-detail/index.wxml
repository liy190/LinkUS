<view class="page"><view class="hero center"><view class="big">{{activity.emoji}}</view><view class="title">{{activity.title}}</view><view class="subtitle">{{activity.time}}</view></view><view class="card"><view class="name">📍 {{activity.place}}</view><view class="subtitle">{{activity.description}}</view><view class="divider"></view><view class="muted">{{activity.seats}} seats remaining</view></view><button class="button" bindtap="join">{{activity.joined ? 'Leave activity' : 'Join activity'}}</button></view>
