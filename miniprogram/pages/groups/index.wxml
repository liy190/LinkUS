<view class="screen"><linkus-header bind:add="add"/><view class="search">⌕ search</view><view wx:for="{{list}}" wx:key="id" class="group-row" data-id="{{item.id}}" bindtap="open"><view class="avatar">{{item.avatar}}</view><view class="grow"><view class="name">{{item.name}} ({{item.members}})</view><view class="preview">{{item.description}}</view></view><view class="meta"><view class="time">{{index ? '12:20 07/13' : '1:25'}}</view><view class="badge" wx:if="{{item.joined}}">{{index + 1}}</view></view></view></view>
