<view class="page list-page">
  <view class="hero"><view class="title">Stay connected</view><view class="subtitle">Direct messages, campus groups and place discussions.</view></view>
  <view class="section-title">Messages</view>
  <view class="list-wrap">
    <view wx:for="{{list}}" wx:key="id" class="list-card row" data-id="{{item.id}}" data-title="{{item.title}}" bindtap="open">
      <view class="avatar">{{item.avatar}}</view><view class="grow"><view class="row between"><view class="name">{{item.title}}</view><view class="badge" wx:if="{{item.unread}}">{{item.unread}}</view></view><view class="muted preview">{{item.preview}}</view></view>
    </view>
  </view>
</view>
