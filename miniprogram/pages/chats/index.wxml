<view class="screen">
  <linkus-header bind:add="add"/>
  <view class="search"><image src="/images/figma/search.svg" mode="aspectFit"/><text>search</text></view>
  <view class="list">
    <view wx:for="{{list}}" wx:key="id" class="chat-row" data-id="{{item.id}}" data-title="{{item.title}}" data-avatar="{{item.avatar}}" bindtap="open">
      <image class="avatar" src="{{item.avatar}}" mode="aspectFill"/>
      <view class="grow"><view class="name">{{item.title}}</view><view class="preview">{{item.preview}}</view></view>
      <view class="meta"><view class="time">{{index ? '22:20 09/05' : '10:25'}}</view><view class="badge" wx:if="{{item.unread}}">{{item.unread}}</view></view>
    </view>
  </view>
  <view class="empty" wx:if="{{!loading && !list.length}}">No conversations yet. Tap + to meet another LinkUS user.</view>
  <view class="tab-safe"></view>
</view>
