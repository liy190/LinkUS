<view class="screen">
  <linkus-header bind:add="add"/>
  <view class="search">
    <image src="/images/figma/search.svg" mode="aspectFit"/>
    <input class="search-input" value="{{keyword}}" placeholder="Search chats" placeholder-class="search-placeholder" confirm-type="search" bindinput="search"/>
    <text class="search-clear" wx:if="{{keyword}}" bindtap="clearSearch">×</text>
  </view>
  <view class="list">
    <view wx:for="{{visible}}" wx:key="id" class="chat-row" data-id="{{item.id}}" data-title="{{item.title}}" data-avatar="{{item.avatar}}" bindtap="open">
      <image class="avatar" src="{{item.avatar}}" mode="aspectFill"/>
      <view class="grow"><view class="name">{{item.title}}</view><view class="preview">{{item.preview}}</view></view>
      <view class="meta"><view class="time">{{item.time}}</view><view class="badge" wx:if="{{item.unread}}">{{item.unread}}</view></view>
    </view>
  </view>
  <view class="empty" wx:if="{{!loading && !visible.length && keyword}}">No chats match your search.</view>
  <view class="empty" wx:if="{{!loading && !visible.length && !keyword}}">No conversations yet. Tap + to meet another LinkUS user.</view>
  <view class="tab-safe"></view>
</view>
