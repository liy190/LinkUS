.screen{min-height:100vh;background:#fff}.search{height:48rpx;margin:10rpx 18rpx;padding:0 18rpx;border-radius:8rpx;background:#f1f1f1;color:#999;font-size:21rpx;display:flex;align-items:center;justify-content:center}.chat-row{display:flex;align-items:center;padding:15rpx 28rpx}.avatar{width:72rpx;height:72rpx;border-radius:50%;background:#e7eef8;margin-right:18rpx}.preview{color:#929292;font-size:20rpx;margin-top:5rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.meta{align-self:stretch;display:flex;flex-direction:column;align-items:flex-end;justify-content:space-around}.time{color:#666;font-size:18rpx}.empty{padding:100rpx 60rpx;text-align:center;color:#8b96a7;font-size:22rpx;line-height:1.6}
