.screen{min-height:100vh;background:#fff}.search{height:64rpx;margin:12rpx 16rpx;padding:0 18rpx;border-radius:20rpx;background:#fff;color:#111;font-size:28rpx;display:flex;align-items:center;justify-content:center;gap:7rpx;box-shadow:0 0 0 12rpx #ededed}.search image{width:28rpx;height:28rpx;opacity:.55}.search text{opacity:.5}.list{padding:12rpx 0}.chat-row{display:flex;align-items:flex-start;min-height:84rpx;padding:16rpx 46rpx}.avatar{width:84rpx;height:84rpx;border-radius:50%;background:#e7eef8;margin-right:30rpx;flex-shrink:0}.name{font-size:29rpx;color:#2c2d3a}.preview{max-width:430rpx;color:#9a9bb1;font-size:21rpx;font-weight:600;margin-top:12rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.meta{margin-left:auto;align-self:stretch;display:flex;flex-direction:column;align-items:flex-end;justify-content:space-between}.time{color:#686a8a;font-size:20rpx;font-weight:600}.badge{border-radius:8rpx;background:#40c4ff}.empty{padding:100rpx 60rpx;text-align:center;color:#8b96a7;font-size:22rpx;line-height:1.6}.tab-safe{height:160rpx}

/* --- local demo polish: search field --- */
.search{justify-content:flex-start;gap:10rpx}
.search-input{flex:1;height:64rpx;font-size:26rpx;color:#111}
.search-placeholder{color:#a6a6a6}
.search-clear{width:40rpx;text-align:center;color:#9a9bb1;font-size:32rpx;line-height:1}
