.map-page { min-height: 100vh; background: #dfe9ed; position: relative; overflow: hidden; }
.top { position: absolute; z-index: 5; top: 24rpx; left: 24rpx; right: 24rpx; }
.profile,.privacy-icon { width: 76rpx; height: 76rpx; border-radius: 38rpx; background: #fff; display:flex;align-items:center;justify-content:center;box-shadow:0 6rpx 24rpx rgba(30,45,70,.18); }
.search { background:#fff;border-radius:40rpx;margin:0 16rpx;padding:20rpx 28rpx;box-shadow:0 6rpx 24rpx rgba(30,45,70,.14); }
.campus-map { height: 69vh; position: relative; background: linear-gradient(25deg,#d9edd8,#e9f1e5); overflow:hidden; }
.campus-label { position:absolute;top:145rpx;left:130rpx;color:#89998d;font-size:20rpx;letter-spacing:3rpx; }
.road { position:absolute;background:#fff;border:4rpx solid #d6dcdf;border-radius:60rpx; }
.road-a { width:900rpx;height:70rpx;left:-100rpx;top:370rpx;transform:rotate(-16deg); }
.road-b { width:70rpx;height:700rpx;left:365rpx;top:70rpx;transform:rotate(22deg); }
.road-c { width:600rpx;height:48rpx;left:80rpx;top:610rpx;transform:rotate(10deg); }
.place-pin { position:absolute; transform:translate(-50%,-50%); text-align:center; z-index:3; }
.pin { width:72rpx;height:72rpx;border-radius:38rpx;background:#fff;display:flex;align-items:center;justify-content:center;box-shadow:0 8rpx 18rpx rgba(27,54,73,.2);font-size:34rpx; }
.pin-name { background:#1677ff;color:#fff;font-size:18rpx;padding:4rpx 10rpx;border-radius:14rpx;margin-top:4rpx;white-space:nowrap; }
.person-pin { position:absolute;z-index:4;width:62rpx;height:62rpx;background:#fff;border:5rpx solid #1677ff;border-radius:50%;display:flex;align-items:center;justify-content:center; }
.sheet { height:31vh;background:#f4f7fb;border-radius:36rpx 36rpx 0 0;margin-top:-36rpx;position:relative;z-index:6;padding:30rpx 28rpx;box-sizing:border-box; }
.place-scroll { white-space:nowrap;margin-top:22rpx; }
.mini-card { display:inline-block;vertical-align:top;width:250rpx;background:#fff;border-radius:24rpx;padding:22rpx;margin-right:16rpx;white-space:normal; }
.mini-emoji { font-size:46rpx;margin-bottom:10rpx; }
