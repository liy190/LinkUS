.map-screen,.real-map{width:100%;height:100vh}.left-tool{position:fixed;left:24rpx;top:110rpx;width:72rpx;height:72rpx;border-radius:50%;background:#dff4ff;border:3rpx solid #6ba7d5;display:flex;align-items:center;justify-content:center;font-size:42rpx;box-shadow:0 4rpx 14rpx rgba(0,0,0,.2)}.right-tools{position:fixed;right:24rpx;top:110rpx;display:flex;flex-direction:column;gap:18rpx}.circle-tool{width:72rpx;height:72rpx;border-radius:50%;background:#fff;color:#0d2c68;display:flex;align-items:center;justify-content:center;font-size:32rpx;box-shadow:0 4rpx 14rpx rgba(0,0,0,.24);border:2rpx solid #d6d6d6}.circle-tool.small{margin-top:8rpx;font-size:40rpx}.bottom-search,.place-card{position:fixed;left:0;right:0;bottom:calc(132rpx + env(safe-area-inset-bottom));background:#fff;border-radius:24rpx 24rpx 0 0;padding:10rpx 24rpx 24rpx;box-shadow:0 -4rpx 16rpx rgba(0,0,0,.16)}.grab{width:90rpx;height:7rpx;border-radius:5rpx;background:#c7c7c7;margin:0 auto 14rpx}.search-strip{height:56rpx;padding:0 14rpx;border-radius:8rpx;background:#ededed;color:#777;font-size:22rpx;display:flex;align-items:center}.dolphin-mini{margin-left:auto;font-size:34rpx}.place-row{padding:20rpx 44rpx 10rpx;display:flex;align-items:center;justify-content:space-between}.place-copy{flex:1;text-align:center}.place-title{font-size:34rpx;font-weight:800;color:#111}.place-sub{font-size:14rpx;color:#555;margin:3rpx 0 7rpx}.distance{font-size:20rpx;color:#1f7de7;font-weight:600}.photo-box{width:96rpx;height:96rpx;margin-left:20rpx;border-radius:12rpx;background:#dfe9ef;display:flex;align-items:center;justify-content:center;font-size:45rpx}.avatar-line{height:70rpx;display:flex;align-items:center;padding:4rpx 40rpx 10rpx}.avatar-caption{font-size:19rpx;color:#6b7280;margin-right:14rpx}.mini-avatar{width:54rpx;height:54rpx;border-radius:50%;border:4rpx solid #fff;margin-left:-10rpx;background:#e8eef6}.people-total{font-size:18rpx;color:#637083;margin-left:10rpx}.card-actions{display:flex;padding:0 40rpx;gap:14rpx}.detail-button,.navigate-button{flex:1;height:58rpx;border-radius:10rpx;display:flex;align-items:center;justify-content:center;font-size:21rpx;font-weight:700}.detail-button{color:#1f7de7;background:#e9f2ff}.navigate-button{color:#fff;background:#1f7de7}.close{position:absolute;right:14rpx;top:4rpx;width:56rpx;height:56rpx;border-radius:50%;background:#fff;color:#777;font-size:38rpx;display:flex;align-items:center;justify-content:center}.sharing-status{font-size:17rpx;color:#8793a3;text-align:center;margin-top:12rpx}
