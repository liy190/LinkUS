.profile-page{min-height:100vh;background:#fff;padding-bottom:40rpx}.profile-nav{height:220rpx;padding:90rpx 36rpx 18rpx;box-sizing:border-box;display:flex;align-items:center;justify-content:space-between;border-bottom:2rpx solid #e9eaeb;box-shadow:0 8rpx 24rpx rgba(13,10,44,.06)}.nav-circle{width:72rpx;height:72rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#59a9ee;font-size:38rpx;box-shadow:0 8rpx 24rpx rgba(13,10,44,.08)}.wordmark{width:176rpx;height:80rpx}.message{width:58rpx;height:58rpx;border-radius:50%;background:#58a9eb;color:#fff;display:flex;align-items:center;justify-content:center;font-size:18rpx;letter-spacing:2rpx}.identity{padding:38rpx 52rpx 10rpx;display:flex;align-items:center}.big-avatar{position:relative;width:220rpx;height:220rpx;border-radius:50%;background:#c9efff;flex-shrink:0}.big-avatar>image{width:100%;height:100%;border-radius:50%;border:4rpx solid #d7d7d7;box-sizing:border-box}.edit-dot{position:absolute;right:-2rpx;top:6rpx;width:54rpx;height:54rpx;border-radius:50%;background:#40c4ff;color:#fff;font-size:28rpx;display:flex;align-items:center;justify-content:center}.identity-copy{margin-left:58rpx}.profile-name{font-size:40rpx;font-weight:700}.handle{font-size:23rpx;color:#706c6c;font-weight:600}.stats{margin-top:22rpx;display:grid;grid-template-columns:auto auto;gap:10rpx 34rpx;font-size:25rpx;color:#706c6c}.stat-count{text-align:right;color:#0d1217;font-weight:700}.edit-button{width:400rpx;margin:6rpx auto 18rpx;background:#5392f0;color:#fff;border:0;border-radius:20rpx;line-height:84rpx;font-size:27rpx;font-weight:600}.edit-button::after{border:0}.profile-tabs{height:66rpx;margin:0 50rpx;display:flex;align-items:center;justify-content:space-around;color:#aaa;font-size:42rpx}.profile-tabs view{width:132rpx;text-align:center}.profile-tabs .selected{color:#2c2d3a;border-bottom:4rpx solid #2c2d3a}.post-card{margin:20rpx 48rpx;border:2rpx solid #f0f0f0;border-radius:20rpx;padding:34rpx;box-shadow:0 8rpx 12rpx rgba(0,0,0,.16)}.post-head{display:flex;align-items:center}.small-avatar{width:96rpx;height:96rpx;border-radius:50%;background:#dff4ff;border:4rpx solid #72a9cf;margin-right:20rpx}.dots{margin-left:auto;color:#777;letter-spacing:2rpx}.post-photo{height:560rpx;margin-top:24rpx;border-radius:16rpx;position:relative;overflow:hidden;background:linear-gradient(#bfc2ba,#e7d5b2)}.sky{position:absolute;inset:0;background:linear-gradient(#8e9a9c,#d4ccb6)}.parachute{position:absolute;left:42%;top:36%;font-size:80rpx;color:#9a0b22;transform:rotate(-18deg)}.building{position:absolute;right:0;bottom:0;width:28%;height:62%;background:repeating-linear-gradient(0deg,#5a5b56 0,#5a5b56 12rpx,#999 13rpx,#999 19rpx)}.post-actions{display:flex;gap:30rpx;margin-top:24rpx;font-size:25rpx}.ago{margin-left:auto;color:#888}.caption{font-weight:700;margin-top:16rpx}.profile-links{margin:30rpx 48rpx;border-top:2rpx solid #eee}.profile-links view{padding:24rpx 4rpx;border-bottom:2rpx solid #eee;color:#555;display:flex;justify-content:space-between}
