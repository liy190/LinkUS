<view class="page"><view class="hero profile"><view class="profile-avatar">{{profile.avatar}}</view><view class="title">{{profile.nickname}}</view><view class="subtitle">{{profile.handle}} · {{profile.faculty}}</view><view class="bio">{{profile.bio}}</view></view><view class="card"><view class="name">Interests</view><view><text wx:for="{{profile.interests}}" wx:key="*this" class="pill">{{item}}</text></view></view><view class="menu"><view class="list-card row" data-url="/pages/profile-edit/index" bindtap="go"><view class="menu-icon">✏️</view><view class="grow name">Edit profile</view><view class="chevron">›</view></view><view class="list-card row" data-url="/pages/privacy/index" bindtap="go"><view class="menu-icon">🛡️</view><view class="grow"><view class="name">Location privacy</view><view class="muted">{{privacy.enabled ? 'Sharing place for ' + privacy.duration + ' min' : 'Location is private'}}</view></view><view class="chevron">›</view></view><view class="list-card row" data-url="/pages/feedback/index" bindtap="go"><view class="menu-icon">💬</view><view class="grow name">Send feedback</view><view class="chevron">›</view></view></view></view>
