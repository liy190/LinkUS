.composer{padding:20rpx}
.composer .field{margin:0 0 16rpx}
.composer-bar{display:flex;align-items:center;justify-content:space-between}
.scope-row{display:flex;gap:16rpx;margin:8rpx 0 4rpx}
.scope{padding:10rpx 26rpx;border-radius:999rpx;background:#f2f4f7;color:#5a6a7d;font-size:22rpx}
.scope-on{background:#1f7de7;color:#fff}
.post{padding:22rpx}
.post-head{display:flex;align-items:center;margin-bottom:14rpx}
.post-text{font-size:27rpx;line-height:1.6;color:#2c2d3a;word-break:break-word}
.post-actions{display:flex;align-items:center;gap:28rpx;margin-top:16rpx;font-size:22rpx;color:#8a96a8}
.like.liked{color:#e0574f;font-weight:700}
.delete{color:#c0332e}
