page { background: #fff; color: #111; font-family: Arial, Helvetica, sans-serif; font-size: 28rpx; }
.page { min-height: 100vh; box-sizing: border-box; padding: 24rpx; background: #fff; }
.row { display: flex; align-items: center; }
.between { justify-content: space-between; }
.grow { flex: 1; min-width: 0; }
.name { color: #111; font-size: 28rpx; font-weight: 700; }
.muted { color: #8a8a8a; font-size: 22rpx; }
.subtitle { color: #777; font-size: 24rpx; line-height: 1.5; }
.avatar { width: 76rpx; height: 76rpx; border-radius: 50%; background: #eee; display: flex; align-items: center; justify-content: center; font-size: 40rpx; margin-right: 20rpx; overflow: hidden; }
.list-card { background: #fff; padding: 22rpx 28rpx; border-bottom: 2rpx solid #ededed; }
.badge { min-width: 30rpx; height: 30rpx; padding: 0 6rpx; border-radius: 6rpx; background: #43c9f5; color: #fff; font-size: 18rpx; display: flex; align-items: center; justify-content: center; }
.button { background: #5598ef; color: #fff; border: 0; border-radius: 10rpx; font-size: 26rpx; font-weight: 500; line-height: 76rpx; }
.button::after, .secondary::after { border: 0; }
.secondary { background: #43c4ef; color: #fff; border: 0; border-radius: 10rpx; font-size: 25rpx; line-height: 72rpx; }
.field { box-sizing: border-box; width: 100%; margin: 10rpx 0 24rpx; padding: 22rpx 18rpx; border: 2rpx solid #e2e2e2; border-radius: 8rpx; background: #fff; }
.label { margin-top: 20rpx; font-size: 25rpx; font-weight: 700; }
.pill { display: inline-block; margin: 8rpx 8rpx 0 0; padding: 7rpx 14rpx; border-radius: 18rpx; background: #eef6ff; color: #458ce6; font-size: 20rpx; }
.card { margin: 18rpx 0; padding: 24rpx; border: 2rpx solid #ececec; border-radius: 8rpx; background: #fff; }
.section-title { margin: 28rpx 0 12rpx; font-size: 28rpx; font-weight: 700; }
.chevron { color: #aaa; font-size: 34rpx; }
.empty { padding: 80rpx 24rpx; text-align: center; color: #999; }
.divider { height: 2rpx; margin: 22rpx 0; background: #eee; }
