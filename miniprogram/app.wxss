page { background: #f4f7fb; color: #182237; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; font-size: 28rpx; }
.page { min-height: 100vh; box-sizing: border-box; padding: 28rpx; }
.hero { background: linear-gradient(140deg, #1677ff, #68b4ff); color: #fff; border-radius: 32rpx; padding: 38rpx; box-shadow: 0 18rpx 50rpx rgba(22,119,255,.22); }
.title { font-size: 42rpx; font-weight: 800; }
.subtitle { color: #738097; margin-top: 10rpx; line-height: 1.55; }
.hero .subtitle { color: rgba(255,255,255,.86); }
.card { background: #fff; border-radius: 28rpx; padding: 28rpx; margin: 22rpx 0; box-shadow: 0 8rpx 30rpx rgba(43,61,91,.07); }
.row { display: flex; align-items: center; }
.between { justify-content: space-between; }
.grow { flex: 1; min-width: 0; }
.avatar { width: 92rpx; height: 92rpx; border-radius: 50%; background: #e7f1ff; display: flex; align-items: center; justify-content: center; font-size: 46rpx; margin-right: 22rpx; }
.name { font-size: 32rpx; font-weight: 700; }
.muted { color: #8792a5; font-size: 25rpx; }
.badge { min-width: 34rpx; height: 34rpx; padding: 0 8rpx; border-radius: 20rpx; background: #ff4d67; color: #fff; font-size: 20rpx; display: flex; align-items: center; justify-content: center; }
.pill { display: inline-block; padding: 10rpx 18rpx; border-radius: 999rpx; background: #edf5ff; color: #1677ff; margin: 8rpx 10rpx 0 0; font-size: 23rpx; }
.section-title { font-size: 32rpx; font-weight: 800; margin: 34rpx 4rpx 14rpx; }
.button { background: #1677ff; color: #fff; border: 0; border-radius: 999rpx; font-weight: 700; line-height: 88rpx; }
.button::after, .secondary::after { border: 0; }
.secondary { background: #eaf3ff; color: #1677ff; border: 0; border-radius: 999rpx; font-weight: 700; line-height: 82rpx; }
.danger { background: #fff0f1; color: #e84052; }
.field { background: #fff; border: 2rpx solid #e3e9f2; border-radius: 22rpx; padding: 24rpx; margin: 14rpx 0 24rpx; box-sizing: border-box; width: 100%; }
.label { font-weight: 700; margin-top: 24rpx; }
.empty { padding: 80rpx 30rpx; text-align: center; color: #8792a5; }
.divider { height: 2rpx; background: #edf0f5; margin: 24rpx 0; }
.chevron { color: #b1bac8; font-size: 36rpx; }
.list-card { background: #fff; padding: 28rpx; border-bottom: 2rpx solid #edf0f5; }
.switch-row { background: #fff; padding: 28rpx; border-radius: 24rpx; margin: 18rpx 0; }
.fab { position: fixed; right: 32rpx; bottom: 150rpx; width: 104rpx; height: 104rpx; border-radius: 52rpx; background: #1677ff; color: #fff; font-size: 54rpx; display: flex; align-items: center; justify-content: center; box-shadow: 0 12rpx 36rpx rgba(22,119,255,.35); }
