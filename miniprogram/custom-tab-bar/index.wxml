<view class="bar {{hidden ? 'is-hidden' : ''}}">
  <view wx:for="{{list}}" wx:key="pagePath" class="item {{selected === index ? 'active' : ''}}" data-path="{{item.pagePath}}" bindtap="switchTab">
    <view class="tab-icon {{item.kind}}">
      <block wx:if="{{item.kind === 'map'}}"><view class="map-pin"></view><view class="map-dot"></view></block>
      <view wx:elif="{{item.kind === 'chat'}}" class="chat-dots"><view></view><view></view><view></view></view>
      <block wx:elif="{{item.kind === 'groups'}}"><view class="head one"></view><view class="head two"></view><view class="shoulder"></view></block>
      <block wx:elif="{{item.kind === 'discover'}}"><view class="compass-needle"></view></block>
      <block wx:else><view class="bell-dome"></view><view class="bell-clapper"></view></block>
    </view>
    <view class="text">{{item.text}}</view>
  </view>
</view>
