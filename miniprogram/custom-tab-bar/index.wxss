.bar{position:fixed;left:0;right:0;bottom:0;z-index:999;height:108rpx;padding:12rpx 18rpx calc(12rpx + env(safe-area-inset-bottom));box-sizing:content-box;background:#fff;display:flex;justify-content:space-around;border-radius:24rpx 24rpx 0 0;box-shadow:0 -8rpx 40rpx rgba(13,10,44,.06)}
.bar.is-hidden{display:none}
.item{width:130rpx;height:96rpx;border-radius:20rpx;color:#9a9bb1;display:flex;flex-direction:column;align-items:center;justify-content:center}
.item.active{background:linear-gradient(135deg,#40c4ff,#03a9f4);color:#fff;box-shadow:0 8rpx 20rpx rgba(3,169,244,.18)}
.text{font-size:20rpx;margin-top:8rpx}
.tab-icon{position:relative;width:42rpx;height:38rpx;color:currentColor}
.map-pin{position:absolute;left:8rpx;top:0;width:26rpx;height:26rpx;border:4rpx solid currentColor;border-radius:50% 50% 50% 0;box-sizing:border-box;transform:rotate(-45deg)}.map-dot{position:absolute;left:17rpx;top:8rpx;width:8rpx;height:8rpx;border-radius:50%;background:currentColor}
.chat{border:4rpx solid currentColor;border-radius:50%;box-sizing:border-box}.chat:after{content:"";position:absolute;left:2rpx;bottom:-7rpx;border-width:7rpx 7rpx 0 0;border-style:solid;border-color:currentColor transparent transparent transparent;transform:rotate(12deg)}
.chat-dots{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;gap:3rpx}.chat-dots view{width:4rpx;height:4rpx;border-radius:50%;background:currentColor}
.groups .head{position:absolute;width:13rpx;height:13rpx;border:3rpx solid currentColor;border-radius:50%;top:2rpx;box-sizing:border-box}.groups .one{left:6rpx}.groups .two{right:6rpx}.groups .shoulder{position:absolute;left:3rpx;right:3rpx;bottom:2rpx;height:17rpx;border:3rpx solid currentColor;border-radius:18rpx 18rpx 10rpx 10rpx;box-sizing:border-box}
.discover{border:3rpx solid currentColor;border-radius:50%;box-sizing:border-box}.compass-needle{position:absolute;left:14rpx;top:8rpx;width:0;height:0;border-left:7rpx solid transparent;border-right:2rpx solid transparent;border-bottom:17rpx solid currentColor;transform:rotate(35deg)}
.notice .bell-dome{position:absolute;left:8rpx;top:3rpx;width:24rpx;height:25rpx;border:3rpx solid currentColor;border-radius:16rpx 16rpx 6rpx 6rpx;box-sizing:border-box}.notice:after{content:"";position:absolute;left:5rpx;right:5rpx;top:27rpx;border-top:3rpx solid currentColor}.bell-clapper{position:absolute;left:18rpx;bottom:0;width:6rpx;height:6rpx;border-radius:50%;background:currentColor}
