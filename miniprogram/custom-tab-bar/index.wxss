.bar{position:fixed;left:0;right:0;bottom:0;z-index:999;height:110rpx;padding:7rpx 10rpx calc(7rpx + env(safe-area-inset-bottom));box-sizing:content-box;background:#fff;display:flex;justify-content:space-around;border-top:2rpx solid #eee;box-shadow:0 -4rpx 14rpx rgba(0,0,0,.05)}.item{width:104rpx;height:90rpx;border-radius:12rpx;color:#888;display:flex;flex-direction:column;align-items:center;justify-content:center}.active{background:#27b9ef;color:#fff}.icon{font-size:31rpx;line-height:34rpx}.text{font-size:18rpx;margin-top:7rpx}
